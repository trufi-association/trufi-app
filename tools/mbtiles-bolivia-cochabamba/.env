# City name (used for input/output filenames). Must match the file in
# ../pbf-bolivia-cochabamba/out/${CITY_NAME}.osm.pbf
CITY_NAME=cochabamba

# Area the tiles cover (west,south,east,north). Keep it equal to BBOX in
# ../pbf-bolivia-cochabamba/.env. It is passed to planetiler explicitly
# because the committed PBF does not always carry a bounds header (see the
# README): without it planetiler falls back to the envelope of every node in
# the file, which reaches far outside the metropolitan area.
BBOX=-66.440262,-17.709721,-65.577835,-17.261759

# Zoom levels. 14 is upstream's recommendation for transit apps.
# 15 gives finer detail but ~4x file size.
MAX_ZOOM=15
MIN_ZOOM=0

# Java heap for planetiler.
JAVA_MEMORY=4g

# Processing threads.
THREADS=4
